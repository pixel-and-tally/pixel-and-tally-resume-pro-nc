---
// A resume-style section: a small caps label in the left column with a rule,
// content on the right. Stacks on phones.
interface Props {
  label: string;
  id?: string;
  tone?: "paper" | "sunk";
  class?: string;
}
const { label, id, tone = "paper", class: cls = "" } = Astro.props;
---

<section id={id} class:list={["scroll-mt-24", tone === "sunk" && "bg-sunk", cls]}>
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-16 sm:px-6 md:grid-cols-[11rem_1fr] md:gap-12 md:py-20">
    <div class="md:pt-2">
      <p class="label">{label}</p>
      <div class="mt-3 hidden h-px w-full bg-rule-strong md:block"></div>
    </div>
    <div class="min-w-0"><slot /></div>
  </div>
</section>
