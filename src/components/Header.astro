---
import Logo from "./Logo.astro";
import { nav, site } from "../site";

const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(href);
const phone = site.phones[0];
---

<header class="border-b border-rule bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80 sticky top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3.5 sm:px-6">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[0.94rem]">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                aria-current={current(n.href) ? "page" : undefined}
                class="text-muted transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
              >
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      {phone && <a href={`tel:${phone.number}`} class="text-sm text-muted hover:text-ink">{phone.number}</a>}
      <a href="/order/" class="btn btn-primary !py-2.5 text-sm">Start an order</a>
    </div>

    <details class="group relative lg:hidden">
      <summary class="btn btn-quiet cursor-pointer list-none !px-3.5 !py-2 text-sm [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
      </summary>
      <div class="absolute right-0 mt-2 w-64 rounded-card border border-rule bg-sheet p-2 shadow-[var(--shadow-sheet)]">
        <ul class="flex flex-col">
          {
            [{ href: "/", label: "Home" }, ...nav].map((n) => (
              <li>
                <a
                  href={n.href}
                  aria-current={(n.href === "/" ? path === "/" : current(n.href)) ? "page" : undefined}
                  class="block rounded px-3 py-2.5 hover:bg-sunk aria-[current=page]:font-semibold aria-[current=page]:text-accent"
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/order/" class="btn btn-primary mt-2 w-full">Start an order</a>
        {site.phones.map((p) => (
          <a href={`tel:${p.number}`} class="mt-1 block px-3 py-2 text-sm text-muted">{p.label}: {p.number}</a>
        ))}
      </div>
    </details>
  </div>
</header>
