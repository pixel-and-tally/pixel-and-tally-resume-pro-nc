---
// Top of an inner page: label, serif title, one-line lead.
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<div class="border-b border-rule">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 pt-14 pb-12 sm:px-6 md:grid-cols-[11rem_1fr] md:gap-12 md:pt-20">
    <p class="label md:pt-4">{label}</p>
    <div>
      <h1 class="text-4xl sm:text-5xl">{title}</h1>
      {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{lead}</p>}
      <slot />
    </div>
  </div>
</div>
