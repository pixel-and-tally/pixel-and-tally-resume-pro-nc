---
import type { CollectionEntry } from "astro:content";
import { blogCategories } from "../site";
import { slugify } from "../lib/blog";
interface Props { posts: CollectionEntry<"blog">[]; active?: string }
const { posts, active } = Astro.props;
---

<nav aria-label="Categories" class="flex flex-wrap gap-2">
  <a href="/career-tips/" aria-current={!active ? "page" : undefined}
    class="rounded border border-rule-strong px-3 py-1.5 text-sm hover:border-ink aria-[current=page]:border-accent aria-[current=page]:bg-accent aria-[current=page]:text-inverse">All</a>
  {blogCategories.map((c) => (
    <a href={`/career-tips/category/${slugify(c)}/`} aria-current={active === c ? "page" : undefined}
      class="rounded border border-rule-strong px-3 py-1.5 text-sm hover:border-ink aria-[current=page]:border-accent aria-[current=page]:bg-accent aria-[current=page]:text-inverse">{c}</a>
  ))}
</nav>

<ul class="mt-10 divide-y divide-rule border-y border-rule">
  {
    posts.map((p) => (
      <li>
        <a href={`/career-tips/${p.id}/`} class="group grid gap-2 py-6 sm:grid-cols-[1fr_12rem] sm:gap-8">
          <span class="font-display text-xl leading-snug group-hover:text-accent sm:text-2xl">{p.data.title}</span>
          <span class="text-sm text-muted sm:text-right">{p.data.categories.join(", ")}</span>
        </a>
      </li>
    ))
  }
</ul>
