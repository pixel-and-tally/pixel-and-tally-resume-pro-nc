---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title="Thank you" noindex>
  <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6" data-thanks data-paypal={site.paypalEmail}>
    <p class="label">Received</p>
    <h1 class="mt-4 text-4xl sm:text-5xl" data-title>Thank you. Your message is in.</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted" data-lead>I'll reply within one business day.</p>

    <div data-order hidden class="mt-10 rounded-card bg-sheet p-7 shadow-[var(--shadow-sheet)]">
      <p class="label">Your order</p>
      <ul class="mt-4 divide-y divide-rule text-sm" data-lines></ul>
      <div class="mt-3 flex items-baseline justify-between border-t-2 border-ink pt-3">
        <span class="font-semibold">Total</span><span class="font-display text-3xl tabular-nums" data-total></span>
      </div>
      <p class="mt-5 text-sm text-muted" data-pay-note>I'll email you an invoice you can pay by credit card, debit card or PayPal. Writing starts once it's paid.</p>
      <a data-pay hidden class="btn btn-primary mt-5" rel="noopener">Pay with PayPal or card</a>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-rule pt-8 sm:flex-row">
      <a href="/career-tips/" class="btn btn-quiet">Read career tips</a>
      <a href="/" class="btn btn-quiet">Back to home</a>
    </div>
  </div>
</Base>

<script>
  import { money, paypalLink } from "../lib/order";
  const root = document.querySelector<HTMLElement>("[data-thanks]")!;
  const p = new URLSearchParams(location.search);
  const kind = p.get("form");
  const title = root.querySelector<HTMLElement>("[data-title]")!;
  const lead = root.querySelector<HTMLElement>("[data-lead]")!;
  if (kind === "order") {
    title.textContent = "Thank you. Your order is in.";
    lead.textContent = root.dataset.paypal
      ? "I've emailed you a copy. Pay below to get started, and I'll be in touch once I've reviewed your details."
      : "I've emailed you a copy. Next, I'll review your details and send your invoice.";
    const total = Number(p.get("total") ?? 0);
    const items = p.getAll("item");
    root.querySelector<HTMLElement>("[data-order]")!.hidden = false;
    root.querySelector<HTMLElement>("[data-lines]")!.replaceChildren(
      ...items.map((i) => Object.assign(document.createElement("li"), { className: "py-2", textContent: i })),
    );
    root.querySelector<HTMLElement>("[data-total]")!.textContent = money(total);
    const link = paypalLink(root.dataset.paypal ?? "", total, `Resume Pro NC: ${items.join(", ")}`);
    if (link) {
      const a = root.querySelector<HTMLAnchorElement>("[data-pay]")!;
      a.href = link;
      a.hidden = false;
      root.querySelector<HTMLElement>("[data-pay-note]")!.textContent = "Pay securely through PayPal by credit card, debit card or PayPal account. You don't need a PayPal account. Writing starts once payment is received.";
    }
  } else if (kind === "paid") {
    title.textContent = "Thank you. Your payment is in.";
    lead.textContent = "Your questionnaire and payment are received, so you're on my writing schedule. You'll get a confirmation email shortly, and I'll contact you if I need anything else while I write.";
  } else if (kind === "unpaid") {
    title.textContent = "Your order is saved.";
    lead.textContent = "You haven't paid yet. I've emailed you a link so you can pay any time. Writing starts once payment is received.";
  } else if (kind === "review") {
    title.textContent = "Thank you. Your resume is in.";
    lead.textContent = "I'll send your free review by email, usually within a couple of business days.";
  } else if (kind === "call") {
    title.textContent = "Thank you. Your call request is in.";
    lead.textContent = "I'll confirm the time by email, then call you at the number you gave.";
  }
</script>
