---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { postDate, slugify, sortedPosts } from "../../lib/blog";

const posts = await sortedPosts();
const i = posts.findIndex((p) => p.id === Astro.params.slug);
if (i < 0) return new Response(null, { status: 404 });
const [post, newer, older] = [posts[i], posts[i - 1], posts[i + 1]];
const { Content } = await render(post);
const desc = (post.body ?? "").replace(/[*#>_]/g, "").replace(/\s+/g, " ").trim().slice(0, 155) || post.data.title;
---

<Base title={post.data.title} description={desc}>
  <article class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-6 md:grid-cols-[11rem_1fr] md:gap-12">
      <div class="md:pt-3">
        <a href="/career-tips/" class="label hover:underline">Career Tips</a>
        <p class="mt-3 text-sm text-muted">{postDate(post.data.date)}</p>
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm md:flex-col">
          {post.data.categories.map((c) => <li><a class="text-muted hover:text-accent" href={`/career-tips/category/${slugify(c)}/`}>{c}</a></li>)}
        </ul>
      </div>
      <div class="max-w-[42rem]">
        <h1 class="text-4xl sm:text-5xl">{post.data.title}</h1>
        {post.data.video && (
          <div class="mt-8 aspect-video overflow-hidden rounded-card bg-ink">
            <iframe class="size-full" src={`https://www.youtube-nocookie.com/embed/${post.data.video}`} title={post.data.title} loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        )}
        <div class="prose-sheet mt-8"><Content /></div>

        <aside class="mt-14 rounded-card bg-sheet p-7 shadow-[var(--shadow-sheet)]">
          <p class="font-display text-2xl">Want a resume that does this for you?</p>
          <p class="mt-2 text-muted">Send your current resume for a free, honest review, or start your order today.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href="/free-resume-review/" class="btn btn-primary">Get a free review</a>
            <a href="/services/" class="btn btn-quiet">See services and pricing</a>
          </div>
        </aside>

        <nav aria-label="More articles" class="mt-12 grid gap-4 border-t border-rule pt-8 sm:grid-cols-2">
          {older && <a href={`/career-tips/${older.id}/`} class="group"><span class="text-xs text-muted">Older</span><span class="mt-1 block font-display text-lg group-hover:text-accent">{older.data.title}</span></a>}
          {newer && <a href={`/career-tips/${newer.id}/`} class="group sm:text-right"><span class="text-xs text-muted">Newer</span><span class="mt-1 block font-display text-lg group-hover:text-accent">{newer.data.title}</span></a>}
        </nav>
      </div>
    </div>
  </article>
</Base>
