---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Field from "../components/Field.astro";
import { reviewCriteria } from "../site";
import { honeypotField, maxUploadBytes, uploadTypes } from "../lib/forms";
const mb = Math.round(maxUploadBytes / 1024 / 1024);
---

<Base title="Free Resume Review" description="Is your resume the best it can be? Send it for a fast, free, no-strings review on 8 points.">
  <PageHead label="Free Resume Review" title="Is your resume the best it can be?" lead="Send your current resume for a fast, free, no-strings review. You get a fair and honest opinion of how it reads to employers. What do you have to lose?" />

  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 sm:px-6 md:grid-cols-[11rem_1fr] md:gap-12">
    <div>
      <p class="label">What I check</p>
      <div class="mt-3 hidden h-px w-full bg-rule-strong md:block"></div>
    </div>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.35fr]">
      <ol class="grid content-start gap-3">
        {
          reviewCriteria.map((c, i) => (
            <li class="flex items-baseline gap-4 border-b border-rule pb-3">
              <span class="font-display text-lg text-accent tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <span class="text-lg">{c}</span>
            </li>
          ))
        }
      </ol>

      <form id="review" method="POST" action="/api/review" enctype="multipart/form-data" novalidate data-review-form class="flex flex-col gap-5 rounded-card bg-sheet p-6 shadow-[var(--shadow-sheet)] sm:p-8">
        <p class="hidden" aria-hidden="true"><label>Leave this empty: <input name={honeypotField} tabindex="-1" autocomplete="off" /></label></p>
        <div data-form-error role="alert" tabindex="-1" hidden class="rounded-card border border-danger px-4 py-3 font-semibold text-danger"></div>
        <h2 class="text-2xl">Send your resume</h2>
        <Field id="name" label="Full name" autocomplete="name" required error="Tell me your name." />
        <Field id="email" label="Email" type="email" autocomplete="email" required error="Enter an email I can send the review to." />
        <Field id="phone" label="Phone" type="tel" inputmode="tel" autocomplete="tel" error="Enter a phone number with area code, like 704-555-0123." />
        <Field id="target" label="The job you're going for" placeholder="For example: operations manager" />
        <div class="flex flex-col gap-1.5">
          <label for="resume" class="text-sm font-semibold">Your resume <span class="text-accent" aria-hidden="true">*</span></label>
          <p id="resume-hint" class="text-xs text-muted">PDF or Word, up to {mb} MB.</p>
          <input id="resume" name="resume" type="file" required accept={uploadTypes.join(",")} data-max-bytes={maxUploadBytes}
            data-error={`Attach your resume as a PDF or Word file under ${mb} MB.`} aria-describedby="resume-hint resume-error"
            class="field file:mr-4 file:rounded file:border-0 file:bg-accent-soft file:px-3 file:py-1.5 file:font-semibold file:text-accent" />
          <p id="resume-error" class="text-sm font-semibold text-danger" hidden></p>
        </div>
        <Field id="notes" label="Anything I should know?" rows={3} />
        <button type="submit" class="btn btn-primary mt-2 w-full sm:w-fit">Send for my free review</button>
        <p class="text-xs text-muted">Your resume is only used for your review and is never shared.</p>
      </form>
    </div>
  </div>
</Base>

<script>
  import { wireForm } from "../scripts/form";
  const form = document.querySelector<HTMLFormElement>("[data-review-form]");
  if (form)
    wireForm(form, {
      failMessage: "That didn't send. Please try again in a minute, or email your resume to Nancy@ResumeProNC.com.",
      successUrl: () => "/thanks/?form=review",
    });
</script>
