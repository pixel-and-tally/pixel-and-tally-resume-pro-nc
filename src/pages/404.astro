---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <p class="label">404</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">That page has moved.</h1>
    <p class="mt-5 text-lg text-muted">The site was rebuilt, so some old links point to new places. Try one of these.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/services/" class="btn btn-quiet">Services & Pricing</a>
      <a href="/career-tips/" class="btn btn-quiet">Career Tips</a>
      <a href="/contact/" class="btn btn-quiet">Contact</a>
    </div>
  </div>
</Base>
