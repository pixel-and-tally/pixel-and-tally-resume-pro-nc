---
import Admin from "../../layouts/Admin.astro";
import { isAdmin, smsLink, telLink } from "../../lib/admin";
import { agenda, clientHref, clients, matches, numbers, type Tone } from "../../lib/desk";
import { money } from "../../lib/order";
import { formatDay, formatStamp, inView, listMessages, listOrders, messageKinds, statuses, views, type ViewId } from "../../lib/records";
import { localDateString } from "../../lib/schedule";
import { store } from "../../lib/store";
import { site } from "../../site";

export const prerender = false;

if (!isAdmin(Astro.cookies)) return Astro.redirect("/admin/login/");

const s = store();
const [orders, messages] = await Promise.all([listOrders(s), listMessages(s)]);
const now = new Date();
const today = localDateString(now, "America/New_York");
const tasks = agenda(orders, messages, now);
const stats = numbers(orders, now);
const q = (Astro.url.searchParams.get("q") ?? "").slice(0, 100);
const people = clients(orders, messages);
const found = people.filter((c) => matches(c, q));

type Tab = ViewId | "today" | "clients";
const tabs: { id: Tab; label: string; count?: number }[] = [
  { id: "today", label: "Today", count: tasks.length },
  ...views.map((v) => ({ id: v.id as Tab, label: v.label, count: inView(orders, v).length })),
  { id: "messages", label: "Messages", count: messages.filter((m) => !m.handled).length },
  { id: "clients", label: "Clients", count: people.length },
];
const asked = (Astro.url.searchParams.get("view") ?? (q ? "clients" : "")) as Tab;
const view: Tab = tabs.some((t) => t.id === asked) ? asked : "today";
const current = views.find((v) => v.id === view);
const rows = current ? inView(orders, current) : [];

const intro: Record<Tab, string> = {
  today: "What needs you, most urgent first. This list comes to your inbox every weekday morning too.",
  clients: "Everyone who has ordered or written in, with all their orders, messages and files in one place.",
  payment: "Questionnaire is in. They go on the schedule once you mark them paid.",
  queued: "Paid and waiting to be written, soonest due first.",
  present: "You're writing, or the draft is with the client.",
  past: "Final files sent, or cancelled.",
  messages: "Contact messages, phone consultation requests and free resume reviews.",
};
const groups: { tone: Tone; label: string }[] = [
  { tone: "late", label: "Overdue" },
  { tone: "today", label: "Today" },
  { tone: "soon", label: "Coming up" },
  { tone: "later", label: "When you have a minute" },
];
const toneDot: Record<Tone, string> = { late: "bg-danger", today: "bg-accent", soon: "bg-mark", later: "bg-rule-strong" };
const badge = (st: string) =>
  st === "delivered" ? "bg-accent-soft text-accent" : st === "awaiting-payment" ? "bg-mark text-ink" : st === "cancelled" ? "bg-sunk text-muted" : "bg-ink text-inverse";
---

<Admin title="Dashboard">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="label">Dashboard</p>
      <h1 class="mt-2 text-3xl sm:text-4xl">{view === "today" ? `${new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", timeZone: "America/New_York" }).format(now)}` : view === "clients" ? "Your clients" : "Your orders"}</h1>
    </div>
    <div class="flex flex-col items-end gap-2">
      <a href="/admin/send-link/" class="btn btn-primary">Send an order link</a>
      <p class="text-sm text-muted">{orders.length} orders, {messages.length} messages in total</p>
    </div>
  </div>

  <nav aria-label="Order lists" class="mt-8 flex gap-1 overflow-x-auto border-b border-rule">
    {
      tabs.map((t) => (
        <a href={`/admin/?view=${t.id}`} aria-current={t.id === view ? "page" : undefined}
          class:list={["-mb-px flex shrink-0 items-center gap-2 border-b-2 px-3 py-2.5 text-sm font-semibold", t.id === view ? "border-accent text-ink" : "border-transparent text-muted hover:text-ink"]}>
          {t.label}
          <span class:list={["rounded-full px-2 py-0.5 text-xs tabular-nums", t.id === view ? "bg-accent text-inverse" : "bg-sunk text-muted"]}>{t.count}</span>
        </a>
      ))
    }
  </nav>
  <p class="mt-4 text-sm text-muted">{intro[view]}</p>

  {
    view === "today" && (
      <>
        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-card border border-rule bg-rule lg:grid-cols-4">
          {[
            ["Paid this month", money(stats.paidThisMonth)],
            ["New orders this month", String(stats.ordersThisMonth)],
            ["On your writing schedule", String(stats.onSchedule)],
            ["Waiting on payment", money(stats.unpaidTotal)],
          ].map(([k, v]) => (
            <div class="bg-sheet p-4 sm:p-5"><dt class="text-xs font-semibold text-muted">{k}</dt><dd class="mt-1 font-display text-2xl tabular-nums sm:text-3xl">{v}</dd></div>
          ))}
        </dl>
        {tasks.length ? groups.filter((g) => tasks.some((t) => t.tone === g.tone)).map((g) => (
          <section class="mt-8" aria-labelledby={`g-${g.tone}`}>
            <h2 id={`g-${g.tone}`} class="flex items-center gap-2 text-sm font-semibold"><span class:list={["size-2.5 rounded-full", toneDot[g.tone]]} aria-hidden="true"></span>{g.label}</h2>
            <ul class="mt-3 divide-y divide-rule rounded-card border border-rule bg-sheet">
              {tasks.filter((t) => t.tone === g.tone).map((t) => (
                <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:px-5">
                  <div>
                    <a href={t.href} class="font-semibold underline-offset-4 hover:underline">{t.title}</a>
                    <p class="mt-0.5 text-sm text-muted">{t.detail}</p>
                  </div>
                  <div class="flex shrink-0 flex-wrap gap-2 text-sm">
                    {t.phone && <a href={telLink(t.phone)} class="btn btn-quiet !px-3 !py-1.5">Call</a>}
                    {t.phone && <a href={smsLink(t.phone, t.text ?? "")} class="btn btn-quiet !px-3 !py-1.5">Text</a>}
                    <a href={t.href} class="btn btn-primary !px-3 !py-1.5">Open</a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )) : (
          <p class="mt-8 rounded-card border border-dashed border-rule-strong p-8 text-center text-muted">Nothing needs you right now. New orders, messages and due dates show up here.</p>
        )}
        <p class="mt-8 max-w-3xl text-xs text-muted">
          Running on its own: {site.morningEmail && "this list lands in your inbox every weekday at 7 AM, "}clients get a "got it" email when they write in or order, PayPal payments move orders to Queued and send your "Received Payment" email{site.autoPaymentReminderDays > 0 && `, and anyone unpaid after ${site.autoPaymentReminderDays} days gets one friendly payment reminder in your words (after that, it's a call or text from you)`}.
        </p>
      </>
    )
  }

  {
    view === "clients" && (
      <>
        <form method="get" class="mt-6 flex max-w-xl gap-2" role="search">
          <input type="hidden" name="view" value="clients" />
          <label for="q" class="sr-only">Search clients</label>
          <input id="q" name="q" type="search" value={q} autocomplete="off" placeholder="Name, email, phone or service" class="field flex-1" />
          <button class="btn btn-quiet">Search</button>
        </form>
        {found.length ? (
          <ul class="mt-6 divide-y divide-rule rounded-card border border-rule bg-sheet">
            {found.map((c) => (
              <li>
                <a href={clientHref(c.email)} class="grid gap-2 p-4 hover:bg-paper sm:grid-cols-[1.4fr_1.6fr_auto] sm:items-center sm:gap-6 sm:px-5">
                  <div>
                    <p class="font-display text-xl">{c.name}</p>
                    <p class="text-sm text-muted">{c.email}{c.phone && ` · ${c.phone}`}</p>
                  </div>
                  <p class="text-sm text-muted">
                    {[c.orders.length && `${c.orders.length} order${c.orders.length === 1 ? "" : "s"}`, c.messages.length && `${c.messages.length} message${c.messages.length === 1 ? "" : "s"}`, c.spent && `${money(c.spent)} paid`].filter(Boolean).join(" · ")}
                  </p>
                  <span class="text-xs text-muted">Last {formatStamp(c.lastAt)}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-6 rounded-card border border-dashed border-rule-strong p-8 text-center text-muted">{q ? `No client matches "${q}".` : "No clients yet."}</p>
        )}
      </>
    )
  }

  {
    current && (rows.length ? (
      <ul class="mt-6 divide-y divide-rule rounded-card border border-rule bg-sheet">
        {rows.map((o) => {
          const late = o.dueDate && o.dueDate < today && (o.status === "queued" || o.status === "writing");
          return (
            <li>
              <a href={`/admin/orders/${o.id}/`} class="grid gap-2 p-4 hover:bg-paper sm:grid-cols-[1.4fr_1.6fr_auto] sm:items-center sm:gap-6 sm:px-5">
                <div>
                  <p class="font-display text-xl">{o.name}</p>
                  <p class="text-sm text-muted">{o.email}{o.phone && ` · ${o.phone}`}</p>
                </div>
                <div class="text-sm">
                  <p>{o.lines.map((l) => l.name).join(", ")}</p>
                  <p class="text-muted">
                    {money(o.total)} · ordered {formatStamp(o.createdAt)}
                    {o.rush && <span class="font-semibold text-danger"> · Rush: {o.rush}</span>}
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-end">
                  <span class:list={["rounded-full px-2.5 py-1 text-xs font-semibold", badge(o.status)]}>{statuses[o.status]}</span>
                  {o.dueDate && o.status !== "delivered" && o.status !== "cancelled" && (
                    <span class:list={["text-xs", late ? "font-semibold text-danger" : "text-muted"]}>{late ? "Overdue: " : "Draft due "}{formatDay(o.dueDate)}</span>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="mt-6 rounded-card border border-dashed border-rule-strong p-8 text-center text-muted">Nothing here right now.</p>
    ))
  }

  {
    view === "messages" && (messages.length ? (
      <ul class="mt-6 divide-y divide-rule rounded-card border border-rule bg-sheet">
        {messages.map((m) => (
          <li>
            <a href={`/admin/messages/${m.id}/`} class="grid gap-2 p-4 hover:bg-paper sm:grid-cols-[1.4fr_1.6fr_auto] sm:items-center sm:gap-6 sm:px-5">
              <div>
                <p class:list={["font-display text-xl", m.handled && "text-muted"]}>{m.name}</p>
                <p class="text-sm text-muted">{m.email}{m.phone && ` · ${m.phone}`}</p>
              </div>
              <p class="line-clamp-2 text-sm text-muted">{m.callAt ? `Call: ${m.callAt}` : m.subject || m.body || m.target}</p>
              <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-end">
                <span class="rounded-full bg-sunk px-2.5 py-1 text-xs font-semibold">{messageKinds[m.kind]}</span>
                <span class="text-xs text-muted">{m.handled ? "Handled" : formatStamp(m.createdAt)}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 rounded-card border border-dashed border-rule-strong p-8 text-center text-muted">No messages yet.</p>
    ))
  }
</Admin>
